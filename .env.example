# Telegram Bot token from @BotFather
BOT_TOKEN=123456:your-token-here

# Telegram user IDs (numbers). Comma-separated for the lists.
# OWNER_ID — главный владелец (имеет все права админа и модератора).
OWNER_ID=123456789
ADMIN_IDS=123456789
MODERATOR_IDS=123456789

# Crypto wallets, which the bot will show to the buyer at checkout.
TON_WALLET=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
USDT_TRC20_WALLET=Txxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQLite database path (relative to project root).
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Optional: set to "1" to print SQL.
SQL_ECHO=0

# Mini App: HTTPS URL to the deployed frontend. When set, the bot shows
# "🚀 Открыть приложение" button in the main menu and configures the chat
# menu button to launch the WebApp.
WEBAPP_URL=

# API backend (FastAPI). Used to validate Telegram initData via BOT_TOKEN.
# Optional dev override that bypasses initData validation locally:
# DEV_USER_ID=123456789
# CORS_ORIGINS=https://your-frontend.example.com,https://other.example.com
